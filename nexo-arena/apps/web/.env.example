NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required for publishing; local preview can leave this empty.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Set to 1 only for publishing the guest website with online variables empty.
NEXO_OFFLINE_RELEASE=
