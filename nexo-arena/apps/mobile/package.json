{
  "name": "@nexo/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "export": "expo export --clear --platform android --platform ios --output-dir dist-native",
    "export:web": "expo export --clear --platform web --output-dir dist-web",
    "test": "jest --runInBand",
    "eas-build-pre-install": "node ../../scripts/native-preflight.mjs"
  },
  "dependencies": {
    "@nexo/engine": "*",
    "@nexo/online": "*",
    "@nexo/shared": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
