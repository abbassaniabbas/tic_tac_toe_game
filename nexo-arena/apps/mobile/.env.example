# Public build metadata only. No server or admin secrets belong in this app.
APP_VARIANT=development
APP_IDENTIFIER=com.nexoarena.game
# Set to the real project UUID from your Expo account after eas init.
EAS_PROJECT_ID=

# Optional shared online backend. Public URL and publishable (or legacy anon) key only.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Hosted Next.js website for invitations/support; required for production release.
EXPO_PUBLIC_WEB_URL=
